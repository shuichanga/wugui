# syntax=docker/dockerfile:1
# ---- 构建阶段：Nuxt SPA 静态产出 ----
FROM node:22-alpine AS builder
WORKDIR /app

# pnpm 10 + corepack（版本对齐根 package.json 的 packageManager）
ENV COREPACK_NPM_REGISTRY=https://registry.npmmirror.com
RUN corepack enable && corepack prepare pnpm@10.13.1 --activate

# 根包（wugui，即 Nuxt 应用）依赖清单
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json .npmrc ./
# 只装根包依赖（workspace 里 apps/packages 的依赖与本构建无关）
# CI 跑在美国节点：CLI 覆盖为 npmjs 官方源，比 npmmirror 跨境快得多（完整性由锁文件 hash 保证）
# --ignore-scripts 跳过根包 postinstall 的 nuxt prepare（generate 内部会执行）
RUN --mount=type=cache,id=pnpm-store-web,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter wugui --ignore-scripts \
      --registry=https://registry.npmjs.org \
      --network-concurrency=8 --fetch-retries=5 --fetch-retry-maxtimeout=120000 --fetch-timeout=60000

# 复制源码（上下文裁剪见 deploy/Dockerfile.web.dockerignore）
COPY . .
RUN pnpm generate

# ---- 运行阶段：nginx 托管静态文件 ----
FROM nginx:alpine
COPY --from=builder /app/.output/public /usr/share/nginx/html
COPY deploy/nginx-web.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
