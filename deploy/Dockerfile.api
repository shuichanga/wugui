# ---- 构建阶段 ----
FROM node:20-alpine AS builder
WORKDIR /app

# pnpm 10 + corepack
RUN corepack enable && corepack prepare pnpm@10.12.0 --activate

# 依赖清单
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json .npmrc ./
COPY apps/api/package.json apps/api/
COPY packages/core/package.json packages/core/
RUN pnpm install --frozen-lockfile

# 复制源码
COPY . .

# 编译 workspace 两个包
RUN pnpm --filter @wugui/core build \
 && pnpm --filter @wugui/api build

# 用 pnpm deploy 生成自包含部署包
# 会自动把 workspace 依赖（@wugui/core）复制进来，脱离符号链接
RUN pnpm --filter @wugui/api deploy --prod /deployed

# ---- 运行阶段 ----
FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production

# 复制自包含部署包（包含 dist/ + package.json + node_modules/）
COPY --from=builder /deployed ./

EXPOSE 3000
CMD ["node", "dist/main.js"]
