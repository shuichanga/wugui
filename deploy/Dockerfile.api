# ---- 构建阶段 ----
FROM node:20-alpine AS builder
WORKDIR /app

# pnpm 10 + corepack（corepack 走国内源下载 pnpm；版本对齐根 package.json 的 packageManager，避免运行时再下载一次）
ENV COREPACK_NPM_REGISTRY=https://registry.npmmirror.com
RUN corepack enable && corepack prepare pnpm@10.13.1 --activate

# 依赖清单
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json .npmrc ./
COPY apps/api/package.json apps/api/
COPY packages/core/package.json packages/core/
# 只装 api 及其 workspace 依赖（core），不装根包的 Nuxt 全家桶；
# --ignore-scripts 跳过根包 postinstall 的 nuxt prepare（Docker 里用不到）
RUN pnpm install --frozen-lockfile --filter @wugui/api... --ignore-scripts

# 复制源码
COPY . .

# 编译 workspace 两个包
RUN pnpm --filter @wugui/core build \
 && pnpm --filter @wugui/api build

# 用 pnpm deploy 生成自包含部署包
# 会自动把 workspace 依赖（@wugui/core）复制进来，脱离符号链接
# pnpm v10 必须加 --legacy（除非 .npmrc 配置 inject-workspace-packages=true）
RUN pnpm --filter @wugui/api deploy --prod --legacy /deployed

# ---- 运行阶段 ----
FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production

# 复制自包含部署包（包含 dist/ + package.json + node_modules/）
COPY --from=builder /deployed ./

EXPOSE 3000
CMD ["node", "dist/main.js"]
