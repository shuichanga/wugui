# ---- 构建阶段 ----
FROM node:20-alpine AS builder
WORKDIR /app

# pnpm 10 + corepack（corepack 走国内源下载 pnpm；版本对齐根 package.json 的 packageManager，避免运行时再下载一次）
ENV COREPACK_NPM_REGISTRY=https://registry.npmmirror.com
RUN corepack enable && corepack prepare pnpm@10.13.1 --activate

# 依赖清单
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json .npmrc ./
COPY apps/api/package.json apps/api/
COPY packages/core/package.json packages/core/
# --ignore-scripts 跳过根包 postinstall 的 nuxt prepare（Docker 里用不到）
RUN pnpm install --frozen-lockfile --filter @wugui/api... --ignore-scripts

# 复制源码
COPY . .

# 编译 workspace 两个包
RUN pnpm --filter @wugui/core build \
 && pnpm --filter @wugui/api build

# 关键：--offline 让 deploy 完全从本地 store 解析（上面 install 已把全部包缓存进 store），
# 不再联网拉依赖元数据——服务器 3M 带宽下联网解析必超时（ERR_PNPM_META_FETCH_FAIL 的根因）
RUN pnpm --filter @wugui/api deploy --prod --legacy --offline /deployed

# ---- 运行阶段 ----
FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production

# 复制自包含部署包（包含 dist/ + package.json + node_modules/，已脱离符号链接）
COPY --from=builder /deployed ./

EXPOSE 3000
CMD ["node", "dist/main.js"]
