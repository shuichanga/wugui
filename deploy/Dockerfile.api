# syntax=docker/dockerfile:1
# ---- 构建阶段 ----
FROM node:20-alpine AS builder
WORKDIR /app

# pnpm 10 + corepack（corepack 走国内源下载 pnpm；版本对齐根 package.json 的 packageManager，避免运行时再下载一次）
ENV COREPACK_NPM_REGISTRY=https://registry.npmmirror.com
RUN corepack enable && corepack prepare pnpm@10.13.1 --activate

# 依赖清单
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json .npmrc ./
COPY apps/api/package.json apps/api/
COPY packages/core/package.json packages/core/
# --ignore-scripts 跳过根包 postinstall 的 nuxt prepare（Docker 里用不到）
# pnpm store 用 BuildKit cache mount 持久化：锁文件变更或下载中断后重试，只补差量不全量重下
# 3M 带宽下调低并发、加大重试，避免偶发 fetch 超时（ERR_PNPM_META_FETCH_FAIL）
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter @wugui/api... --ignore-scripts \
      --network-concurrency=8 --fetch-retries=5 --fetch-retry-maxtimeout=120000 --fetch-timeout=60000

# 复制源码
COPY . .

# 编译 workspace 两个包
RUN pnpm --filter @wugui/core build \
 && pnpm --filter @wugui/api build

# 裁剪 devDependencies。锁文件冻结 + store 缓存挂载（与第 7 层共用），纯差量完成
# 必须带 --filter：不加会装全 workspace 的 prod 依赖（根包的 nuxt 全家桶，跨境源下爬不完）
# （不能用 pnpm deploy：它内部强制按版本范围重新解析依赖元数据，
#   --offline/--frozen-lockfile 都拦不住，服务器 3M 带宽下必然 ERR_PNPM_META_FETCH_FAIL）
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --prod --frozen-lockfile --filter @wugui/api... --ignore-scripts \
      --network-concurrency=8 --fetch-retries=5 --fetch-retry-maxtimeout=120000 --fetch-timeout=60000

# workspace 符号链接（node_modules/@wugui/core → packages/core）替换为真实文件，
# 运行镜像里不再有跨目录符号链接
RUN rm -rf node_modules/@wugui \
 && mkdir -p node_modules/@wugui/core \
 && cp -r packages/core/dist node_modules/@wugui/core/dist \
 && cp packages/core/package.json node_modules/@wugui/core/package.json

# ---- 运行阶段 ----
FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/api/dist ./dist
COPY --from=builder /app/apps/api/package.json ./package.json
# 数据库迁移 SQL（手动执行 mysql 建表用）
COPY --from=builder /app/apps/api/drizzle ./drizzle

EXPOSE 3000
CMD ["node", "dist/main.js"]
