# ---- MySQL ----
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_PASSWORD=CHANGE_ME_WUGUI_PASSWORD

# ---- API 镜像（CI 构建推送到 ACR，服务器只拉取）----
# 同地域 ECS 用 registry-vpc 内网域名拉取：免费且快；异地/本地调试换 registry.cn-shenzhen
# 服务器首次使用前需 docker login 该域名（ACR 固定密码）
API_IMAGE=registry-vpc.cn-shenzhen.aliyuncs.com/shuichanga/wugui-api:latest

# ---- 应用 ----
NODE_ENV=production
PORT=3000
DATABASE_URL=mysql://wugui:CHANGE_ME_WUGUI_PASSWORD@mysql:3306/wugui
JWT_SECRET=CHANGE_ME_GENERATE_LONG_RANDOM_STRING
JWT_EXPIRES=7d

# ---- 阿里云 OSS ----
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=wugui-photos
OSS_ACCESS_KEY_ID=REPLACE_ME
OSS_ACCESS_KEY_SECRET=REPLACE_ME
OSS_ENDPOINT=https://wugui-photos.oss-cn-hangzhou.aliyuncs.com

# ---- 微信小程序 ----
WECHAT_APP_ID=wx_YOUR_APPID
WECHAT_APP_SECRET=REPLACE_ME

# ---- 虚拟支付（Phase 4）----
WECHAT_OFFER_ID=REPLACE_ME
WECHAT_PAY_APP_KEY=REPLACE_ME
