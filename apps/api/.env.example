# ---- 服务 ----
PORT=3000
NODE_ENV=development

# ---- 数据库（MySQL）----
# 本地开发（docker compose 起 MySQL 后）：mysql://wugui:wugui@localhost:3306/wugui
# 生产环境：mysql://wugui:CHANGE_ME@host.docker.internal:3306/wugui
DATABASE_URL=mysql://wugui:wugui@localhost:3306/wugui

# ---- JWT 会话 ----
JWT_SECRET=dev-insecure-secret-change-me
JWT_EXPIRES=7d

# ---- 阿里云 OSS ----
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=wugui-photos
OSS_ACCESS_KEY_ID=REPLACE_ME
OSS_ACCESS_KEY_SECRET=REPLACE_ME
OSS_ENDPOINT=https://wugui-photos.oss-cn-hangzhou.aliyuncs.com

# ---- 微信 ----
WECHAT_APP_ID=wx_YOUR_APPID
WECHAT_APP_SECRET=REPLACE_ME
# 虚拟支付（Phase 4 用）
WECHAT_OFFER_ID=REPLACE_ME
WECHAT_PAY_APP_KEY=REPLACE_ME

# ---- 短信（Phase 4 用）----
ALIYUN_SMS_ACCESS_KEY_ID=REPLACE_ME
ALIYUN_SMS_ACCESS_KEY_SECRET=REPLACE_ME
ALIYUN_SMS_SIGN_NAME=wugui
